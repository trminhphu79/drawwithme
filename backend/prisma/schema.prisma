generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person using the app. Identified by a stable per-browser client id while
/// anonymous; `type` flips to "human" once accounts/login arrive (no password
/// stored yet).
model User {
  id        String   @id // = the browser clientId (uuid)
  username  String?
  avatar    String?
  type      String   @default("anonymous") // anonymous | human
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships RoomMember[]
}

model Room {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String      @default("Untitled Room")
  passwordHash String?
  /// Stable client id (User id) of the user who created the room (the host).
  hostId       String?
  width        Int         @default(3840)
  height       Int         @default(2400)
  status         String      @default("active")
  createdAt      DateTime    @default(now())
  /// Bumped on any join / draw op / chat message; used by the 24h cleanup cron.
  lastActivityAt DateTime    @default(now())
  /// Shared reference image (R2 URL or data URL fallback).
  referenceImageUrl String?
  operations   Operation[]
  artworks     Artwork[]
  messages     Message[]
  settings     RoomSettings?
  members      RoomMember[]
}

/// Records that a user joined a room (the room's total roster, all-time).
model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([userId])
}

/// Per-room configuration (1:1 with Room).
model RoomSettings {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// "auto" = anyone with the link joins immediately; "approval" = host admits.
  joinMode  String   @default("auto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A chat message within a room.
model Message {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    String
  avatar    String?
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// Event-sourced drawing log — the canvas is reconstructed by replaying these.
model Operation {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seq       Int      @default(autoincrement())
  type      String // stroke | erase | fill
  color     String
  size      Int
  opacity   Float
  points    Json
  style     String? // pencil style: hard | soft | shadow
  authorId  String?
  isUndone  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([roomId, seq])
}

/// A sealed, completed artwork from a finished session.
/// Sealed artwork — self-contained so its share link survives room cleanup.
model Artwork {
  id           String   @id @default(uuid())
  /// Nullable + SetNull so a purged room doesn't delete the shared artwork.
  roomId       String?
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomCode     String? // kept for reference after the room is gone
  title        String   @default("Untitled Masterpiece")
  imageUrl     String? // R2 URL (or data URL fallback) of the rasterized snapshot
  participants String[]
  /// Snapshot of the operation log at finish time — powers replay via the link.
  operations   Json?
  createdAt    DateTime @default(now())

  @@index([roomId])
}
