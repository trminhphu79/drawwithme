# Global Docker environment for DrawWithMe.
# Copy to `.env` (which is gitignored) and edit per environment:
#   cp .env.example .env
# On the VPS, set CORS_ORIGIN to the public URL the site is served from.

# ---- Postgres ----
POSTGRES_USER=drawwithme
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=drawwithme
# Host port for Postgres (bound to 127.0.0.1 only).
DB_PORT=5432

# ---- API (NestJS) ----
# The API always listens on 3000 inside the compose network; this is the host port.
API_PORT=3000
# Must match POSTGRES_* above. Host is the compose service name "db".
DATABASE_URL=postgresql://drawwithme:change-me-strong@db:5432/drawwithme?schema=public
# Comma-separated allowed origins = the public URL(s) the FE is served from.
CORS_ORIGIN=http://localhost,http://YOUR_VPS_IP

# ---- Web (nginx serving the built FE + proxying /api and /socket.io) ----
WEB_PORT=80
