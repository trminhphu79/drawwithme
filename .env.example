# Global Docker environment for DrawWithMe.
# Copy to `.env` (which is gitignored) and edit per environment:
#   cp .env.example .env
# On the VPS, set CORS_ORIGIN to the public URL the site is served from.

# ---- Postgres ----
POSTGRES_USER=drawwithme
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=drawwithme
# Host port for Postgres (bound to 127.0.0.1 only).
DB_PORT=5432

# ---- API (NestJS) ----
# The API always listens on 3000 inside the compose network; this is the host port.
API_PORT=3000
# Must match POSTGRES_* above. Host is the compose service name "db".
DATABASE_URL=postgresql://drawwithme:change-me-strong@db:5432/drawwithme?schema=public
# Comma-separated allowed origins = the public URL(s) the FE is served from.
# NO trailing slash, scheme+host only. Use https:// once TLS is live.
CORS_ORIGIN=https://tranminhphu.com,https://www.tranminhphu.com

# ---- Web (Caddy serves the built FE + proxies /api and /socket.io) ----
# Domains Caddy serves + auto-provisions Let's Encrypt TLS for.
# MUST be SPACE-separated (a bare comma crashes Caddy) and QUOTED (so deploy.sh's
# `source .env` doesn't run each domain as a command). Compose strips the quotes.
# Every domain (apex + www) must point at this VPS before TLS can issue.
SITE_ADDRESS="tranminhphu.com www.tranminhphu.com"

# ---- Admin panel ----
# One admin is seeded on first boot if this username doesn't already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong
# Secret used to sign admin session tokens (any long random string).
ADMIN_JWT_SECRET=change-me-random

# ---- Cloudflare R2 (object storage for reference + finished images) ----
# Leave blank to fall back to storing media as data URLs in Postgres (dev).
# Enable public access (or a custom domain) on the bucket for permanent URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
