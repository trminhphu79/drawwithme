# ---- dependencies ----
node_modules/
**/node_modules/

# ---- secrets / env (copied manually to the VPS) ----
.env
.env.*
!.env.example
!**/.env.example

# NOTE: BOTH frontend/dist and backend/dist are intentionally tracked. The VPS
# pulls the prebuilt output and the containers just run it — no compile on prod.
# nginx serves frontend/dist; the API image COPYs backend/dist and runs it.

# ---- TS incremental build cache (not needed at runtime) ----
*.tsbuildinfo

# ---- logs / tmp ----
*.log
npm-debug.log*
/tmp/
.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp

# ---- prisma generated client (regenerated on build) ----
/backend/node_modules/.prisma/
